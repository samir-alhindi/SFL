
import "lib\\std.sfl"

data Shape =
    Circle radius |
    Rectangle width height |
    Triangle base height;

my_circle = Circle 5.5;
my_rect   = Rectangle 10 20;
my_tri    = Triangle 5 12;

-- Automatically generated getters: 
r = radius my_circle;
w = width my_rect;
h = height my_rect;

-- destructors
area shape = match shape with
    case Circle r      -> r * r * 3.14
    case Rectangle w h -> w * h
    case Triangle b h  -> b * h * 0.5
    else -> "Please enter a shape object";

a1 = area my_circle;
a2 = area my_rect;
a3 = area my_tri;

my_shapes = [
    Triangle 0.5 2,
    Circle 6,
    Rectangle 6 8
];

areas = map area my_shapes;

data Person = Person name age hobby;

samir = Person "Samir" 20 "Coding";

h = hobby samir;
a = age samir;

greeting person = match person with
    case Person name age hobby -> "Hello, My name is " ++ name ++ " I am " ++ (show age) ++ " years old."
    else -> "Please pass in a person";

g = greeting samir;